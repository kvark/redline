(
    body: (
        visual: (
            model: "models/race-future-body.glb",
            pos: (0, -0.3, 0.1),
            rot: (0, 180, 0),
        ),
        collider: (
            density: 210.0,
            friction: 0.12,
            restitution: 0.22,
            shape: ConvexHull(
                // Wheels are the driving contact. Keep the hull above the tire
                // radius (0.28) so the chassis slides instead of digging in.
                border_radius: 0.16,
                points: [
                    (-0.36, -0.06, -0.62), (0.36, -0.06, -0.62),
                    (-0.36, -0.06, 0.62), (0.36, -0.06, 0.62),
                    (-0.50, 0.04, -1.00), (0.50, 0.04, -1.00),
                    (-0.50, 0.04, 1.00), (0.50, 0.04, 1.00),
                    (-0.48, 0.22, -0.78), (0.48, 0.22, -0.78),
                    (-0.48, 0.22, 0.78), (0.48, 0.22, 0.78),
                ],
            ),
        ),
    ),
    wheel: (
        visual: (
            model: "models/wheel-racing.glb",
        ),
        collider: (
            density: 80.0,
            // A sphere gives the tire a smooth physical contact patch over the
            // triangulated planet. The rendered wheel remains cylindrical.
            friction: 1.15,
            restitution: 0.0,
            shape: Ball(
                radius: 0.30,
            ),
        ),
    ),
    suspender: (
        density: 40.0,
        shape: Ball(
            radius: 0.22,
        ),
    ),
    // Velocity-motor damping on wheel spin. Too high and throttle slams;
    // too low and the car will not hold speed on the climb of the sphere.
    drive_factor: 55.0,
    jump_impulse: 14,
    roll_impulse: 10,
    body_mass: 130.0,
    axles: [
        (
            x_wheels: [-0.5, 0.5],
            y: -0.1,
            z: 0.7,
            max_steering_angle: 32,
            max_suspension_offset: 0.20,
            steering: (
                stiffness: 9000,
                damping: 1800,
                max_force: 2200,
            ),
            suspension: (
                stiffness: 14000,
                damping: 1800,
                max_force: 3600,
            ),
        ),
        (
            x_wheels: [-0.5, 0.5],
            y: -0.1,
            z: -0.8,
            max_suspension_offset: 0.20,
            suspension: (
                stiffness: 15000,
                damping: 1900,
                max_force: 3800,
            ),
        ),
    ],
)
